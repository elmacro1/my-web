---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/hero/hero.astro";
import Capabilities from "../components/capabilities/capabilities.astro";
import Process from "../components/process/process.astro";
import Header from "../components/header/header.astro";
import Footer from "../components/footer/footer.astro";
import Featured from "../components/featured/featured.astro";
import ExperienceSummary from "../components/experience-summary/experience-summary.astro";
import ContactCta from "../components/contact-cta/contact-cta.astro";
import dictionaryJson from "../dictionaries/en.json";
import type { Dictionary } from "../models/dictionary.model";
import { CV_PATHS } from "../consts";
import styles from "./_index.module.css";

const dictionary = dictionaryJson as Dictionary;

const config = {
    lang: "en" as const,
    metadata: dictionary.metadata,
    alternates: [
        { lang: "en", href: "/" },
        { lang: "es", href: "/es/" },
        { lang: "x-default", href: "/" },
    ],
    canonicalPath: "/",
};
const cvUrl = CV_PATHS[config.lang];
---

<Layout {...config}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header lang={config.lang} dictionary={dictionary.navigation} cvUrl={cvUrl} />
    <main id="main" class={styles.main}>
        <div class={styles.content_container}>
            <Hero dictionary={dictionary.hero} />
            <Capabilities dictionary={dictionary.capabilities} />
            <Process dictionary={dictionary.process} />
            <Featured dictionary={dictionary.selectedWork} />
            <ExperienceSummary dictionary={dictionary.experienceSummary} cvUrl={cvUrl} />
            <ContactCta dictionary={dictionary.contact} />
        </div>
    </main>
    <Footer
        lang={config.lang}
        dictionary={dictionary.footer}
        navigation={dictionary.navigation}
        cvUrl={cvUrl}
    />
</Layout>
