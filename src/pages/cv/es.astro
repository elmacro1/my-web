---
import CVHeader from "../../components/cv/CVHeader.astro";
import CVSection from "../../components/cv/CVSection.astro";
import ExperienceItem from "../../components/cv/ExperienceItem.astro";
import ProjectItem from "../../components/cv/ProjectItem.astro";
import SkillsGroup from "../../components/cv/SkillsGroup.astro";
import { cvData } from "../../data/cv/es";
import CVLayout from "../../layouts/CVLayout.astro";
import styles from "../../layouts/CVLayout.module.css";

const sectionId = (title: string) =>
    title
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)/g, "");
const sectionIds = {
    summary: sectionId(cvData.labels.summary),
    experience: sectionId(cvData.labels.experience),
    projects: sectionId(cvData.labels.projects),
    skills: sectionId(cvData.labels.skills),
    languages: sectionId(cvData.labels.languages),
};
---

<CVLayout metadata={cvData.metadata}>
    <a class={styles.skipLink} href="#cv-main">{cvData.labels.skipLink}</a>

    <header class={styles.header}>
        <CVHeader header={cvData.header} />
    </header>

    <main class={styles.main} id="cv-main">
        <section class={styles.section} aria-labelledby={sectionIds.summary}>
            <CVSection title={cvData.labels.summary}>
                <div class={styles.summary}>
                    {cvData.summary.map((paragraph) => <p>{paragraph}</p>)}
                </div>
            </CVSection>
        </section>

        <section class={styles.section} aria-labelledby={sectionIds.experience}>
            <CVSection title={cvData.labels.experience}>
                <ul class={styles.contentList}>
                    {
                        cvData.experiences.map((experience, index) => (
                            <li>
                                <article
                                    class:list={[
                                        styles.item,
                                        index === cvData.experiences.length - 1 &&
                                            styles.printPageStart,
                                    ]}
                                    data-cv-item
                                >
                                    <ExperienceItem
                                        experience={experience}
                                        technologyLabel={cvData.labels.technologies}
                                    />
                                </article>
                            </li>
                        ))
                    }
                </ul>
            </CVSection>
        </section>

        <section class={styles.section} aria-labelledby={sectionIds.projects}>
            <CVSection title={cvData.labels.projects}>
                <ul class={styles.contentList}>
                    {
                        cvData.projects.map((project) => (
                            <li>
                                <article class={styles.item} data-cv-item>
                                    <ProjectItem
                                        project={project}
                                        technologyLabel={cvData.labels.technologies}
                                    />
                                </article>
                            </li>
                        ))
                    }
                </ul>
            </CVSection>
        </section>

        <section class={styles.section} aria-labelledby={sectionIds.skills}>
            <CVSection title={cvData.labels.skills} className={styles.compactSection}>
                <div class={styles.skillsList}>
                    {cvData.skillGroups.map((group) => <SkillsGroup group={group} />)}
                </div>
            </CVSection>
        </section>

        <section class={styles.section} aria-labelledby={sectionIds.languages}>
            <CVSection title={cvData.labels.languages} className={styles.compactSection}>
                <ul class={styles.languageList}>
                    {
                        cvData.languages.map((language) => (
                            <li>
                                <span class={styles.languageName}>{language.name}:</span>{" "}
                                {language.proficiency}
                            </li>
                        ))
                    }
                </ul>
            </CVSection>
        </section>
    </main>
</CVLayout>
