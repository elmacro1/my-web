---
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-sans/700.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { SITE_URL, SOCIAL_LINKS } from "../consts";

interface AlternateLanguage {
    lang: string;
    href: string;
}

interface Props {
    lang: "en" | "es";
    title?: string;
    description?: string;
    canonicalPath?: string;
    ogImage?: string;
    ogType?: "website" | "profile";
    alternates?: AlternateLanguage[];
    noindex?: boolean;
}

const {
    lang,
    title = lang === "en"
        ? "Marco Galván | Software Developer"
        : "Marco Galván | Desarrollador de Software",
    description = lang === "en"
        ? "Software Developer building web, mobile, SaaS, and business software products with TypeScript, React, Next.js, React Native, Node.js, and PostgreSQL."
        : "Desarrollador de Software especializado en productos web, móviles, SaaS y software para negocios con TypeScript, React, Next.js, React Native, Node.js y PostgreSQL.",
    canonicalPath = Astro.url.pathname,
    ogImage = `${SITE_URL}/og-image.png`,
    ogType = "profile",
    alternates = [],
    noindex = false,
}: Props = Astro.props;

const canonicalURL = new URL(canonicalPath, SITE_URL).href;

const defaultAlternate = alternates.find(
    (alternate) => alternate.lang === "x-default",
);

const personId = `${SITE_URL}/#person`;
const profilePageId = `${canonicalURL}#profile-page`;

const structuredData = {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": profilePageId,
    url: canonicalURL,
    name: title,
    headline:
        lang === "en"
            ? "Marco Galván — Software Developer"
            : "Marco Galván — Desarrollador de Software",
    description,
    inLanguage: lang,
    isPartOf: {
        "@type": "WebSite",
        "@id": `${SITE_URL}/#website`,
        url: SITE_URL,
        name: "Marco Galván",
    },
    mainEntity: {
        "@type": "Person",
        "@id": personId,
        name: "Marco Galván",
        url: SITE_URL,
        image: {
            "@type": "ImageObject",
            url: ogImage,
        },
        email: "mailto:elmacro11@gmail.com",
        jobTitle:
            lang === "en" ? "Software Developer" : "Desarrollador de Software",
        address: {
            "@type": "PostalAddress",
            addressLocality: "Santiago del Estero",
            addressCountry: "AR",
        },
        worksFor: {
            "@type": "Organization",
            name: "Dam Squad",
        },
        knowsAbout: [
            "Software Development",
            "Web Development",
            "Mobile Application Development",
            "SaaS",
            "TypeScript",
            "React",
            "Next.js",
            "React Native",
            "Node.js",
            "PostgreSQL",
            "Software Architecture",
            "Artificial Intelligence",
        ],
        sameAs: [SOCIAL_LINKS.linkedin, SOCIAL_LINKS.github, SOCIAL_LINKS.x],
        mainEntityOfPage: {
            "@id": profilePageId,
        },
    },
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title}</title>

        <meta name="description" content={description} />
        <meta name="author" content="Marco Galván" />
        <meta
            name="robots"
            content={noindex
                ? "noindex, follow"
                : "index, follow, max-image-preview:large"}
        />
        <meta name="theme-color" content="#0a0a0a" />

        <link rel="canonical" href={canonicalURL} />

        {
            alternates.map(({ lang: alternateLang, href }) => (
                <link
                    rel="alternate"
                    hreflang={alternateLang}
                    href={new URL(href, SITE_URL).href}
                />
            ))
        }

        {
            !defaultAlternate && alternates.length > 0 && (
                <link
                    rel="alternate"
                    hreflang="x-default"
                    href={canonicalURL}
                />
            )
        }

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content="Marco Galván" />
        <meta
            property="og:locale"
            content={lang === "en" ? "en_US" : "es_AR"}
        />
        <meta property="og:image" content={ogImage} />
        <meta
            property="og:image:alt"
            content={lang === "en"
                ? "Marco Galván — Software Developer"
                : "Marco Galván — Desarrollador de Software"}
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        {
            alternates
                .filter(({ lang: alternateLang }) =>
                    ["en", "es"].includes(alternateLang),
                )
                .map(({ lang: alternateLang }) => (
                    <meta
                        property="og:locale:alternate"
                        content={alternateLang === "en" ? "en_US" : "es_AR"}
                    />
                ))
        }

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta
            name="twitter:image:alt"
            content={lang === "en"
                ? "Marco Galván — Software Developer"
                : "Marco Galván — Desarrollador de Software"}
        />
        <meta name="twitter:site" content="@MarcoGal4" />
        <meta name="twitter:creator" content="@MarcoGal4" />

        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <script
            type="application/ld+json"
            set:html={JSON.stringify(structuredData)}
        />

        <Analytics />
        <SpeedInsights />
    </head>

    <body>
        <slot />
    </body>
</html>

<style is:global>
    :root {
        background-color: Canvas;
        color: CanvasText;
        color-scheme: dark;
        font-family: "Geist Sans", sans-serif;
    }

    *,
    *::after,
    *::before {
        min-width: 0;
        box-sizing: border-box;
        padding: 0;
        margin: 0;
    }

    img,
    video,
    svg {
        display: block;
        height: auto;
        max-width: 100%;
    }

    html {
        scroll-padding-top: 80px;
    }

    html,
    body {
        min-height: 100dvh;
        scroll-behavior: smooth;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        text-wrap: balance;
    }

    p {
        text-wrap: pretty;
    }

    .skip-link {
        position: absolute;
        left: 8px;
        top: -48px;
        z-index: 100;
        padding: 8px 16px;
        background-color: #fafafa;
        color: #111;
        border-radius: 8px;
        text-decoration: none;
        transition: top 0.15s ease-in-out;
    }

    .skip-link:focus {
        top: 8px;
    }

    :focus-visible {
        outline: 2px solid #fafafa;
        outline-offset: 2px;
        border-radius: 4px;
    }

    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }

        html {
            scroll-behavior: auto;
        }
    }
</style>
