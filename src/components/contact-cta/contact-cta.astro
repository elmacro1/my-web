---
import type { Dictionary } from "../../models/dictionary.model";
import { CONTACT_EMAIL, SOCIAL_LINKS } from "../../consts";
import styles from "./contact-cta.module.css";

interface Props {
    dictionary: Dictionary["contact"];
}

const { dictionary } = Astro.props;
const contactHref = `${CONTACT_EMAIL}?subject=${encodeURIComponent(dictionary.emailSubject)}`;
---

<section id="contact" class={styles.main_container} aria-labelledby="contact-title">
    <div class={styles.panel}>
        <p class={styles.kicker}>05</p>
        <h2 id="contact-title" class={styles.title}>{dictionary.title}</h2>
        <p class={styles.text}>{dictionary.text}</p>
        <div class={styles.button_group}>
            <a class={styles.primary_button} href={contactHref}>
                {dictionary.contactLabel}
            </a>
            <a
                class={styles.secondary_button}
                href={SOCIAL_LINKS.linkedin}
                target="_blank"
                rel="noopener noreferrer"
            >
                {dictionary.linkedinLabel}
            </a>
        </div>
    </div>
</section>
