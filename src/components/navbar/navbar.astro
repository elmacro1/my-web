---
import type { Dictionary } from "../../models/dictionary.model";
import styles from "./navbar.module.css";

interface Props {
    lang: "en" | "es";
    dictionary: Dictionary["navigation"];
    cvUrl: string;
}

const { lang, dictionary, cvUrl } = Astro.props;
const languageHref = lang === "en" ? "/es/" : "/";
const languageCode = lang === "en" ? "ES" : "EN";
const language = lang === "en" ? "es" : "en";
---

<nav class={styles.main_container} aria-label={dictionary.menuLabel}>
    <details class={styles.menu} open>
        <summary class={styles.menu_toggle}>{dictionary.menuLabel}</summary>
        <div class={styles.links_container}>
            <a class={styles.link} href="#work">{dictionary.work}</a>
            <a class={styles.link} href="#process">{dictionary.process}</a>
            <a class={styles.link} href="#about">{dictionary.about}</a>
            <a class={styles.link} href="#contact">{dictionary.contact}</a>
            <a
                class={styles.resume_link}
                href={cvUrl}
                target="_blank"
                rel="noopener noreferrer"
            >
                {dictionary.resumeLabel}
            </a>
            <a
                class={styles.language_link}
                href={languageHref}
                hreflang={language}
                aria-label={dictionary.languageLabel}
            >
                {languageCode}
            </a>
            <a class={styles.cta_link} href="#contact">{dictionary.cta}</a>
        </div>
    </details>
</nav>
