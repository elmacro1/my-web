---
import type { Dictionary } from "../../models/dictionary.model";
import Navbar from "../navbar/navbar.astro";
import styles from "./header.module.css";

interface Props {
    lang: "en" | "es";
    dictionary: Dictionary["navigation"];
    role: string;
}

const { lang, dictionary, role } = Astro.props;
const homeHref = lang === "en" ? "/" : "/es/";
---

<header id="top" class={styles.main_container}>
    <div class={styles.content_container}>
        <a href={homeHref} class={styles.brand} aria-label="Marco Galván">
            <span class={styles.name}>Marco Galván</span>
            <span class={styles.role}>{role}</span>
        </a>
        <Navbar lang={lang} dictionary={dictionary} />
    </div>
</header>
